generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadSource {
  Call
  WhatsApp
  Field
}

enum LeadStatus {
  Interested
  NotInterested
  Converted
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  phone     String
  source    LeadSource
  status    LeadStatus @default(Interested)
  notes     String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("leads")
}
